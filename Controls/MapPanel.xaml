<UserControl x:Class="LostInAForgottenCity.Controls.MapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#0a0f0a">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP: tabs -->
        <Grid Grid.Row="0"
                Background="#0d140d">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                    Margin="4,4,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        x:Name="OpenMapsBtn"
                        Content="+ MAPS"
                        FontFamily="Courier New"
                        FontSize="11"
                        Foreground="#7aaa60"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OpenMapsBtn_Click"/>
                <TextBlock Grid.Column="1"
                           x:Name="SectionTitle"
                           Text="MAP"
                           FontFamily="Courier New"
                           FontSize="11"
                           Foreground="#4a6a4a"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="4,0,4,4">
                <StackPanel x:Name="TabsPanel"
                            Orientation="Horizontal"/>
            </ScrollViewer>
            <Border x:Name="MapsPopup"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Background="#0d140d"
                    BorderBrush="#2a3a2a"
                    BorderThickness="1"
                    Padding="6"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="4,20,0,0"
                    Panel.ZIndex="10">
                <StackPanel x:Name="AvailableMapsPanel"/>
            </Border>
        </Grid>

        <!-- MAP AREA -->
        <Grid Grid.Row="1">
            <!-- Compass -->
            <TextBlock Text="N"
                    FontFamily="Courier New"
                       FontSize="10"
                    Foreground="#4a6a4a"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,2,0,0"
                       Panel.ZIndex="2"/>
            <TextBlock Text="S"
                    FontFamily="Courier New"
                       FontSize="10"
                    Foreground="#4a6a4a"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,2"
                       Panel.ZIndex="2"/>
            <TextBlock Text="W"
                    FontFamily="Courier New"
                       FontSize="10"
                    Foreground="#4a6a4a"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="2,0,0,0"
                       Panel.ZIndex="2"/>
            <TextBlock Text="E"
                    FontFamily="Courier New"
                       FontSize="10"
                    Foreground="#4a6a4a"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,2,0"
                       Panel.ZIndex="2"/>

            <!-- Map border + content -->
            <Border BorderBrush="#2a3a2a"
                    BorderThickness="1"
                    Margin="16"
                    ClipToBounds="True"
                    x:Name="MapBorder"
                    Background="#0a0f0a"
                    MouseDown="MapBorder_MouseDown"
                    MouseMove="MapBorder_MouseMove"
                    MouseUp="MapBorder_MouseUp"
                    MouseWheel="MapBorder_MouseWheel"
                    SizeChanged="MapBorder_SizeChanged">
                <Grid>
                    <!-- Bitmap layer -->
                    <Image x:Name="MapImage"
                           Stretch="None"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           RenderTransformOrigin="0,0"
                           RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="MapScale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                                <TranslateTransform x:Name="MapTranslate"
                                        X="0"
                                        Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <!-- Overlay canvas -->
                    <Canvas x:Name="OverlayCanvas"
                            IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Tooltip popup -->
            <Border x:Name="NodeTooltip"
                    Background="#1a1a2a"
                    BorderBrush="#3a4a3a"
                    BorderThickness="1"
                    Padding="6,4"
                    Visibility="Collapsed"
                    Panel.ZIndex="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="20,20,0,0"
                    IsHitTestVisible="False">
                <StackPanel x:Name="TooltipContent"/>
            </Border>
        </Grid>

        <!-- LEGEND -->
        <Border Grid.Row="2"
                BorderBrush="#2a3a2a"
                BorderThickness="0,1,0,0"
                Background="#0a0f0a"
                Padding="8,6">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="LEGEND"
                               FontFamily="Courier New"
                               FontSize="10"
                               Foreground="#4a6a4a"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            x:Name="LegendToggleBtn"
                            Content="▼"
                            FontFamily="Courier New"
                            FontSize="10"
                            Foreground="#4a6a4a"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LegendToggleBtn_Click"/>
                </Grid>
                <StackPanel x:Name="LegendContent">
                    <WrapPanel Margin="0,0,0,2">
                        <TextBlock Text="□ Undiscovered  "
                                FontFamily="Courier New"
                                FontSize="9"
                                Foreground="#3a4a3a"/>
                        <TextBlock Text="◈ Discovered  "
                                FontFamily="Courier New"
                                FontSize="9"
                                Foreground="#6a8a6a"/>
                        <TextBlock Text="◉ Visited  "
                                FontFamily="Courier New"
                                FontSize="9"
                                Foreground="#7aaa60"/>
                        <TextBlock Text="■ Explored  "
                                FontFamily="Courier New"
                                FontSize="9"
                                Foreground="#c8c860"/>
                        <TextBlock Text="◆ Looted"
                                FontFamily="Courier New"
                                FontSize="9"
                                Foreground="#c8a840"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="▦ REGION  "
                                FontFamily="Courier New"
                                FontSize="9"
                                Foreground="#4a8a4a"/>
                        <TextBlock Text="◎ Location  "
                                FontFamily="Courier New"
                                FontSize="9"
                                Foreground="#4a6a8a"/>
                        <TextBlock Text="● Player"
                                FontFamily="Courier New"
                                FontSize="9"
                                Foreground="#7aaa60"/>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>