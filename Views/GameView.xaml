<UserControl x:Class="LostInAForgottenCity.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LostInAForgottenCity.Controls"
             xmlns:views="clr-namespace:LostInAForgottenCity.Views">
    <Grid Background="#0a0a0f">
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ TOP BAR ═══ -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Background="#1a1a2a">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- MIND BOX -->
            <Border Grid.Column="0"
                    BorderBrush="#9a7a9a"
                    BorderThickness="1"
                    Margin="8,4,4,4">
                <Grid>
                    <TextBlock Text="MIND"
                               FontFamily="Courier New"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#9a7a9a"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,2,0,0"/>
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <controls:SanityBar x:Name="PlayerSanityBar"
                                            Value="50"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,4"/>
                        <WrapPanel>
                            <controls:SubconsciousBar x:Name="PlayerSubconsciousBar"
                                                      Value="5"
                                                      MaxSlots="10"/>
                            <controls:DangerIndicator x:Name="PlayerDangerIndicator"
                                                      Level="Insignificant"
                                                      StatusEffect="None"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                    <!-- Configuring overlay -->
                    <Grid x:Name="MindOverlay"
                          Background="#1a1a2a"
                          Visibility="Collapsed">
                        <TextBlock x:Name="MindOverlayText"
                                   Text="[ configuring ]"
                                   FontFamily="Courier New"
                                   FontSize="11"
                                   Foreground="#4a4a5a"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- SPIRIT BOX -->
            <Border Grid.Column="1"
                    BorderBrush="#c8a8d0"
                    BorderThickness="1"
                    Margin="4,4,4,4">
                <Grid>
                    <TextBlock Text="SPIRIT"
                               FontFamily="Courier New"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#c8a8d0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,2,0,0"/>
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <controls:SoulBar x:Name="PlayerSoulBar"
                                          Value="25"
                                          MaxValue="100"/>
                        <controls:ResistanceBar x:Name="PlayerResistanceBar"
                                                Value="10"
                                                MaxValue="30"
                                                Margin="0,6,0,0"/>
                    </StackPanel>
                    <Grid x:Name="SpiritOverlay"
                          Background="#1a1a2a"
                          Visibility="Collapsed">
                        <TextBlock x:Name="SpiritOverlayText"
                                   Text="[ configuring ]"
                                   FontFamily="Courier New"
                                   FontSize="11"
                                   Foreground="#4a4a5a"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- BODY BOX -->
            <Border Grid.Column="2"
                    BorderBrush="#aa6060"
                    BorderThickness="1"
                    Margin="4,4,8,4">
                <Grid>
                    <TextBlock Text="BODY"
                               FontFamily="Courier New"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#aa6060"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,2,0,0"/>
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <controls:HpBar x:Name="PlayerHpBar"
                                        Value="10"
                                        MaxSegments="20"/>
                        <controls:StaminaSleepBar x:Name="PlayerStaminaSleepBar"
                                                  Value="5"
                                                  MaxSegments="10"
                                                  SleepValue="50"
                                                  IsSleepVisible="True"
                                                  Margin="0,6,0,0"/>
                    </StackPanel>
                    <Grid x:Name="BodyOverlay"
                          Background="#1a1a2a"
                          Visibility="Collapsed">
                        <TextBlock x:Name="BodyOverlayText"
                                   Text="[ configuring ]"
                                   FontFamily="Courier New"
                                   FontSize="11"
                                   Foreground="#4a4a5a"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ MAP ═══ -->
        <Border Grid.Row="1"
                Grid.Column="0"
                BorderBrush="#2a3a2a"
                BorderThickness="0,0,1,0">
            <Grid>
                <controls:MapPanel x:Name="GameMap"/>
                <Grid x:Name="MapOverlay"
                      Background="#0a0f0a"
                      Visibility="Collapsed">
                    <TextBlock x:Name="MapOverlayText"
                               Text="[ configuring ]"
                               FontFamily="Courier New"
                               FontSize="11"
                               Foreground="#4a4a5a"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ CONSOLE ═══ -->
        <views:ConsolePanel x:Name="GameConsole"
                            Grid.Row="1"
                            Grid.Column="1"/>

        <!-- ═══ OVERLAY PANEL ═══ -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              Grid.RowSpan="3"
              Grid.ColumnSpan="2"
              x:Name="GameOverlay"
              Visibility="Collapsed"
              Background="#aa000000"
              Panel.ZIndex="100">
            <Border Background="#1a1a2a"
                    BorderBrush="#3a3a4a"
                    BorderThickness="1"
                    MaxWidth="600"
                    MaxHeight="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
                               x:Name="OverlayTitle"
                               Text="OVERLAY"
                               FontFamily="Courier New"
                               FontSize="16"
                               Foreground="#c8c8b0"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="350"
                                  VerticalScrollBarVisibility="Auto">
                        <ContentControl x:Name="OverlayContent"/>
                    </ScrollViewer>

                    <!-- Close button -->
                    <Button Grid.Row="2"
                            x:Name="OverlayCloseBtn"
                            Content="CLOSE"
                            Style="{StaticResource GameScreenButton}"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            Click="CloseOverlay_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ BOTTOM BAR ═══ -->
        <Grid Grid.Row="2"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Background="#1a1a2a">
            <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Rectangle Grid.Row="0"
                       Fill="#3a3a4a"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Navigation buttons in box -->
                <Border Grid.Column="0"
                        BorderBrush="#7aaa60"
                        BorderThickness="1"
                        Margin="8,4,4,4">
                    <Grid>
                        <TextBlock Text="MENU"
                                   FontFamily="Courier New"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#7aaa60"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,2,0,0"/>
                        <StackPanel VerticalAlignment="Center"
                                    Margin="8,14,8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="ObjectivesBtn"
                                        Content="OBJECTIVES"
                                        Style="{StaticResource GameScreenButton}"
                                        Click="ObjectivesBtn_Click"/>
                                <Button Grid.Column="1"
                                        x:Name="CollectionsBtn"
                                        Content="COLLECTIONS"
                                        Style="{StaticResource GameScreenButton}"
                                        Click="CollectionsBtn_Click"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        x:Name="HistoryBtn"
                                        Content="HISTORY"
                                        Style="{StaticResource GameScreenButton}"
                                        Click="HistoryBtn_Click"/>
                                <Button Grid.Column="1"
                                        x:Name="PauseBtn"
                                        Content="PAUSE"
                                        Style="{StaticResource GameScreenButton}"
                                        Click="PauseBtn_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CENTER: Time Box -->
                <Border Grid.Column="1"
                        BorderBrush="#c8c8b0"
                        BorderThickness="1"
                        Margin="4,4,4,4">
                    <Grid>
                        <TextBlock Text="TIME"
                                   FontFamily="Courier New"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#c8c8b0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,2,0,0"/>
                        <controls:TimeBox x:Name="TimeDisplay"
                                          Day="1"
                                          Hour="15"
                                          Minute="0"
                                          Date="12/06/2012"
                                          Weather="Foggy"
                                          Temperature="8"
                                          FeelsLike="Chilly"
                                          Hazard="None"
                                          IsCurseVisible="False"
                                          Margin="4,14,4,4"/>
                        <Grid x:Name="TimeOverlay"
                              Background="#1a1a2a"
                              Visibility="Collapsed">
                            <TextBlock x:Name="TimeOverlayText"
                                       Text="[ configuring ]"
                                       FontFamily="Courier New"
                                       FontSize="11"
                                       Foreground="#4a4a5a"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT: Relic counter + Inventory in box -->
                <Border Grid.Column="2"
                        BorderBrush="#c8a840"
                        BorderThickness="1"
                        Margin="4,4,8,4">
                    <Grid>
                        <TextBlock Text="INVENTORY"
                                   FontFamily="Courier New"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#c8a840"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,14,8,4">
                            <StackPanel VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                <TextBlock Text="RELICS"
                                           FontFamily="Courier New"
                                           FontSize="11"
                                           Foreground="#c8a840"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="RelicCount"
                                           Text="0"
                                           FontFamily="Courier New"
                                           FontSize="16"
                                           Foreground="#c8a840"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <controls:InventoryBar x:Name="Inventory"
                                                   SlotCount="6"
                                                   VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid x:Name="InventoryOverlay"
                              Background="#1a1a2a"
                              Visibility="Collapsed">
                            <TextBlock x:Name="InventoryOverlayText"
                                       Text="[ configuring ]"
                                       FontFamily="Courier New"
                                       FontSize="11"
                                       Foreground="#4a4a5a"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>